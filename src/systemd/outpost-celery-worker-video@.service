[Unit]
Description=%I - Celery Worker Video

[Service]
Type=simple
Environment=DJANGO_LOCAL_CONFIGURATION=/etc/outpost/%i/django.py
Environment=CELERY_AUTOSCALE=20,4
EnvironmentFile=-/etc/outpost/%i/celery-worker-video.env
WorkingDirectory=/srv/outpost/%i/runtime
User=outpost
ExecSearchPath=/srv/outpost/%i/runtime/bin:/usr/bin:/bin
ExecStart=python3 -m celery -A outpost.django.celery worker -E --loglevel=WARNING -n 'video@%i' --autoscale="${CELERY_AUTOSCALE}" -Q video
UMask=0027

[Install]
WantedBy=outpost@%i.target
