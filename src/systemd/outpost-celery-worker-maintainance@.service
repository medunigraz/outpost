[Unit]
Description=%I - Celery Worker

[Service]
Type=simple
Environment=DJANGO_LOCAL_CONFIGURATION=/etc/outpost/%i.py
WorkingDirectory=/srv/outpost/%i/runtime
User=outpost
ExecSearchPath=/srv/outpost/%i/runtime/bin:/usr/bin:/bin
ExecStart=python3 -m celery -A outpost.django.celery worker -E --loglevel=WARNING -n 'maintainance@%i' --autoscale=20,10 -Q maintainance --purge
LimitNOFILE=500000
LimitNPROC=500000
UMask=0027

[Install]
WantedBy=outpost@%i.target
