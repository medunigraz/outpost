[Unit]
Description=%I - Celery Beat

[Service]
Type=simple
Environment=DJANGO_LOCAL_CONFIGURATION=/etc/outpost/%i/django.py
EnvironmentFile=-/etc/outpost/%i/celery-beat.env
WorkingDirectory=/srv/outpost/%i/runtime
User=outpost
ExecSearchPath=/srv/outpost/%i/runtime/bin:/usr/bin:/bin
ExecStart=python3 -m celery -A outpost.django.celery beat --loglevel=WARNING -s /srv/outpost/%i/state/beat.state --pidfile /srv/outpost/%i/state/beat.pid
UMask=0027

[Install]
WantedBy=outpost@%i.target
