[Unit]
Description=%I - Celery Worker Maintenance

[Service]
Type=simple
Environment=DJANGO_LOCAL_CONFIGURATION=/etc/outpost/%i/django.py
Environment=CELERY_AUTOSCALE=10,2
EnvironmentFile=-/etc/outpost/%i/celery-worker-maintenance.env
WorkingDirectory=/srv/outpost/%i/runtime
User=outpost
ExecSearchPath=/srv/outpost/%i/runtime/bin:/usr/bin:/bin
ExecStart=python3 -m celery -A outpost.django.celery worker -E --loglevel=WARNING -n 'maintenance@%i' --autoscale="${CELERY_AUTOSCALE}" -Q maintenance
LimitNOFILE=500000
LimitNPROC=500000
UMask=0027

[Install]
WantedBy=outpost@%i.target
