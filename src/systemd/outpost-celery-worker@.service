[Unit]
Description=%I - Celery Worker

[Service]
Type=simple
Environment=DJANGO_LOCAL_CONFIGURATION=/etc/outpost/%i/django.py
Environment=CELERY_AUTOSCALE_DEFAULT=10,2
EnvironmentFile=-/etc/outpost/%i/environment
WorkingDirectory=/srv/outpost/%i/runtime
User=outpost
ExecSearchPath=/srv/outpost/%i/runtime/bin:/usr/bin:/bin
ExecStart=python3 -m celery -A outpost.django.celery worker -E --loglevel=WARNING -n 'default@%i' --autoscale="${CELERY_AUTOSCALE_DEFAULT}" -Q default
UMask=0027

[Install]
WantedBy=outpost@%i.target
